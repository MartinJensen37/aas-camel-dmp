{
    "$id": "https://example.com/person.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "kafkaconsumer.json",
    "type": "array",
    "items": {
      "type": "object",
      "required": [
          "uniqueId",
          "topic"
      ],
      "properties": {
        "uniqueId": {
            "type": "string",
            "description": "Unique ID to match options",
            "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "serverUrl": {
            "type": "string",
            "description": "IP or Hostname of the Kafka Server",
            "default": "127.0.0.1",
            "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "serverPort": {
            "description": "Port of the Kafka Server",
            "type": "integer",
            "minimum": 0,
            "maximum": 65535,
            "default": "9092"
        },
        "topic": {
            "type": "string",
            "description": "Topic of the variable in the MQTT Broker"
        },
        "maxPollRecords": {
            "type": "integer",
            "description": "The maximum number of records returned in a single call",
            "minimum": 1,
            "default": "5000"
        },
        "groupId": {
            "type": "string",
            "description": "A unique identifier of the consumer instance.",
            "pattern": "[A-Za-z0-9_.-]+",
            "default": "basyx-updater"
        },
        "consumersCount": {
            "type": "integer",
            "description": "The number of consumers that connect to kafka server. Each consumer is run on a separate thread, that retrieves and process the incoming data.",
            "minimum": 1,
            "default": "1"
        },
        "seekTo": {
            "enum": ["BEGINNING", "END"],
            "description": "Define where to start reading from",
            "default": "BEGINNING"
        },
        "breakOnFirstError": {
            "type": "boolean",
            "description": "Keep the Kafka offset pending when route processing fails",
            "default": false
        },
        "sourceKind": {
            "type": "string",
            "description": "Typed source adapter kind, for example aas-property-event"
        },
        "elementType": {
            "type": "string",
            "description": "Resolved AAS key type for the event source"
        },
        "mode": {
            "enum": ["event", "poll"],
            "description": "Resolved source delivery mode"
        },
        "eventFilter": {
            "type": "object",
            "description": "Transport-neutral AAS event matching and enrichment options",
            "required": ["submodelId", "elementPath"],
            "properties": {
                "submodelId": {"type": "string"},
                "elementPath": {"type": "string"},
                "modelType": {"type": "string"},
                "readUrl": {"type": "string", "format": "uri"}
            }
        }
      }
    }
}
