{
    "$id": "https://example.com/luatransformer.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "luatransformers.json",
    "type": "object",
    "required": [
        "uniqueId",
        "queryPath",
        "inputType",
        "outputType"
    ],
    "properties": {
        "uniqueId": {
            "title": "Unique ID",
            "type": "string",
            "description": "Unique ID to match options",
            "pattern": "^[a-z0-9-]+$"
        },
        "queryPath": {
            "title": "Query Path",
            "type": "string",
            "description": "Path to the Lua blob file (relative only!)",
            "pattern": "^[a-zA-Z0-9/-\\.\\+]+$"
        },
        "inputType": {
            "title": "Input Type",
            "enum": [
                "JsonString",
                "JsonValue"
            ],
            "description": "Type of the input"
        },
        "outputType": {
            "title": "Output Type",
            "enum": [
                "JsonString",
                "JsonValue"
            ],
            "description": "Type of the output"
        },
        "timeoutSeconds": {
            "title": "Timeout Seconds",
            "type": "number",
            "description": "CPU budget per invocation",
            "minimum": 0.1
        },
        "contentCache": {
            "title": "Content Cache",
            "type": "boolean",
            "description": "Cache the script and reload on mtime/sha change"
        },
        "maxScriptBytes": {
            "title": "Max Script Bytes",
            "type": "integer",
            "description": "Max blob size"
        },
        "sourceKeys": {
            "title": "Source Keys",
            "type": "string",
            "description": "How to assemble the sources map: 'body' wraps the whole payload, or a comma-separated list of keys to extract from the payload object"
        }
    }
}
