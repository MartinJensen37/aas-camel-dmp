<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>dk.aau.smartproductionlab</groupId>
		<artifactId>dmp.parent</artifactId>
		<version>${revision}</version>
	</parent>
	<artifactId>dmp.camel-paho</artifactId>
	<name>AAS-Camel-DMP Camel Paho</name>
	<description>MQTT 5 connector: subscriptions, publishes and request/reply</description>

	<packaging>jar</packaging>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
	</properties>

	<build>
		<plugins>
			<plugin>
				<!-- Shares the MQTT 5 test broker with the management and component tests. -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<executions>
					<execution>
						<goals><goal>test-jar</goal></goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<!-- Logging backend for tests only; dmp.component chooses the runtime backend. -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>dk.aau.smartproductionlab</groupId>
			<artifactId>dmp.core</artifactId>
			<version>${revision}</version>
		</dependency>

		<!-- MQTT 5 transport: the paho-mqtt5-inout component delegates the wire
		     protocol (connections, publish, reply subscriptions, reconnect) to
		     the upstream camel-paho-mqtt5 component and only owns the InOut
		     semantics (correlation, pending replies, RUNNING filter, timeout) -->
		<dependency>
			<groupId>org.apache.camel</groupId>
			<artifactId>camel-paho-mqtt5</artifactId>
		</dependency>
		<dependency>
			<groupId>org.eclipse.paho</groupId>
			<artifactId>org.eclipse.paho.mqttv5.client</artifactId>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.camel</groupId>
			<artifactId>camel-test-junit5</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
