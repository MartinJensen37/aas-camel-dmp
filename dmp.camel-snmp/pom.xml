<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>dk.aau.smartproductionlab</groupId>
		<artifactId>dmp.parent</artifactId>
		<version>${revision}</version>
	</parent>
	<artifactId>dmp.camel-snmp</artifactId>
	<name>AAS-Camel-DMP Camel SNMP</name>
	<description>SNMP v1/v2c connector (AID 1.2 SNMP binding): checked GET reads and typed SET writes</description>
	<packaging>jar</packaging>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
	</properties>
	<build>
		<plugins>
			<plugin>
				<!-- Shares the SNMP test agent with the component tests. -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<executions>
					<execution>
						<goals><goal>test-jar</goal></goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<dependencies>
		<!-- Logging backend for tests only; dmp.component chooses the runtime backend. -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>dk.aau.smartproductionlab</groupId>
			<artifactId>dmp.core</artifactId>
			<version>${revision}</version>
		</dependency>
		<!-- camel-snmp's producer has no SET, so dmp-snmp talks to SNMP4J itself. -->
		<dependency>
			<groupId>org.apache.camel</groupId>
			<artifactId>camel-snmp</artifactId>
		</dependency>
		<dependency>
			<groupId>org.snmp4j</groupId>
			<artifactId>snmp4j</artifactId>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
